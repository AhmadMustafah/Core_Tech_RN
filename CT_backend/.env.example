PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=*

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/CoreTech?retryWrites=true&w=majority
MONGODB_DB=CoreTech

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
LOG_LEVEL=info
